{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* "DOM" fournit les types WebSocket/TextEncoder/TextDecoder natifs du
       navigateur ; en environnement Node.js pur, ces types restent
       utilisables mais l'implémentation runtime doit être injectée via
       `webSocketImpl` (Node n'a pas de WebSocket global avant la v22+). */
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "dist", "node_modules"]
}
