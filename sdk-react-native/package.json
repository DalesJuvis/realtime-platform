{
  "name": "@yourorg/realtime-sdk-react-native",
  "version": "0.1.0",
  "description": "Bindings React Native pour @yourorg/realtime-sdk — réexporte le contexte/hooks/composants de @yourorg/realtime-sdk-react, avec reconnexion consciente de AppState et (optionnel) NetInfo.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "realtime",
    "websocket",
    "pubsub",
    "react-native",
    "hooks",
    "multi-tenant"
  ],
  "license": "UNLICENSED",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "@react-native-community/netinfo": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-community/netinfo": {
      "optional": true
    }
  },
  "dependencies": {
    "@yourorg/realtime-sdk": "file:../sdk-typescript",
    "@yourorg/realtime-sdk-react": "file:../sdk-react"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "react-native": "^0.81.0",
    "typescript": "^5.5.0"
  }
}
