# Copy this to .env and fill in real values — .env is gitignored, never
# commit it. See DEPLOY.md for how to generate each secret.

# Caddy's site address (Caddyfile). Set to your domain once DNS points at
# this VPS ("realtime.example.com"), or ":80" for IP-only/no domain yet.
DOMAIN=:80

# Signs Admin API bearer tokens used by the `admin/` app. Required —
# without it a random one is generated on every restart and logged once,
# which breaks admin login on the next restart.
ADMIN_API_TOKEN=

# Signs tenant-portal session cookies/tokens. Required for the same
# reason as ADMIN_API_TOKEN — without it, every restart logs every
# tenant-portal user out.
PORTAL_SESSION_SECRET=

# Optional: a single pre-provisioned demo tenant, HMAC-signed with this
# secret (see backend/src/main.rs). Leave unset in real production — real
# tenants self-serve their own via tenant-portal's signup flow instead of
# sharing one hardcoded tenant.
# DEMO_TENANT_SECRET=

# Optional: Web Push (browser notifications — see
# modules::push::services::WebPushCrypto). Both keys must be set together
# or Web Push stays disabled; see DEPLOY.md ("Optional: Web Push keys")
# for how to generate a real pair on this VPS.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# Optional: FCM (mobile push fallback — see
# modules::push::adapters::FcmPushAdapter). Leave unset unless you're
# actually wiring up native mobile push.
# FCM_PROJECT_ID=
# FCM_BEARER_TOKEN=
